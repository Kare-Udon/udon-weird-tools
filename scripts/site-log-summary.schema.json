{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary"],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ja", "zh-CN"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "ja": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    }
  }
}
