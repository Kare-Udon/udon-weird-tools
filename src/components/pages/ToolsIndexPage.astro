---
import ToolDirectory from '@/components/ToolDirectory';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { localize, pathForLocale } from '@/i18n/utils';
import { categoryOrder, getCategoryLabel, tools } from '@/tools/registry';

const { locale } = Astro.props as { locale: Locale };

const directoryTools = tools.map((tool) => ({
  slug: tool.slug,
  href: pathForLocale(locale, `/tools/${tool.slug}`),
  name: localize(tool.i18n.name, locale),
  description: localize(tool.i18n.description, locale),
  category: getCategoryLabel(tool.category, locale),
  categoryRank: categoryOrder.indexOf(tool.category),
  status: tool.status,
  tags: tool.tags,
}));

const labels = {
  title: t(locale, 'toolsTitle'),
  searchPlaceholder: t(locale, 'toolSearchPlaceholder'),
  viewLabel: t(locale, 'toolViewLabel'),
  listView: t(locale, 'toolViewList'),
  cardView: t(locale, 'toolViewCard'),
  compactView: t(locale, 'toolViewCompact'),
  countSuffix: t(locale, 'toolCountSuffix'),
  nameColumn: t(locale, 'toolNameColumn'),
  categoryColumn: t(locale, 'toolCategoryColumn'),
  tagsColumn: t(locale, 'toolTagsColumn'),
  sortLabel: t(locale, 'toolSortLabel'),
  sortNameAsc: t(locale, 'toolSortNameAsc'),
  sortNameDesc: t(locale, 'toolSortNameDesc'),
  sortCategory: t(locale, 'toolSortCategory'),
  sortStatus: t(locale, 'toolSortStatus'),
};
---

<BaseLayout locale={locale} path="/tools" title={t(locale, 'toolsTitle')} description={t(locale, 'toolsDescription')}>
  <ToolDirectory client:load locale={locale} tools={directoryTools} labels={labels} />
</BaseLayout>
