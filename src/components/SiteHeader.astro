---
import { type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { pathForLocale } from '@/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const { locale, path = '/' } = Astro.props as {
  locale: Locale;
  path?: string;
};
---

<header class="site-header">
  <a class="brand" href={pathForLocale(locale, '/')}>{t(locale, 'siteTitle')}</a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href={pathForLocale(locale, '/')}>{t(locale, 'navHome')}</a>
    <a href={pathForLocale(locale, '/tools')}>{t(locale, 'navTools')}</a>
  </nav>
  <LanguageSwitcher locale={locale} path={path} />
</header>
