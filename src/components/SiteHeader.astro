---
import { type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { pathForLocale } from '@/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const { locale, path = '/' } = Astro.props as {
  locale: Locale;
  path?: string;
};
---

<header class="site-header">
  <a class="brand" href={pathForLocale(locale, '/')}>{t(locale, 'siteTitle')}</a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href={pathForLocale(locale, '/')}>{t(locale, 'navTools')}</a>
    <a href={pathForLocale(locale, '/logs')}>{t(locale, 'navLogs')}</a>
    <a href={pathForLocale(locale, '/about')}>{t(locale, 'navAbout')}</a>
  </nav>
  <div class="header-actions">
    <LanguageSwitcher locale={locale} path={path} />
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t(locale, 'themeToggle')}>
      <span class="theme-toggle-mark" aria-hidden="true"></span>
    </button>
  </div>
</header>
