---
import { localeLabels, locales, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import { pathForLocale } from '@/i18n/utils';

const { locale, path } = Astro.props as {
  locale: Locale;
  path: string;
};
---

<label class="language-select">
  <span class="sr-only">{t(locale, 'languageLabel')}</span>
  <select aria-label={t(locale, 'languageLabel')} data-language-select>
    {locales.map((item) => (
      <option value={pathForLocale(item, path)} selected={item === locale}>
        {localeLabels[item]}
      </option>
    ))}
  </select>
</label>
