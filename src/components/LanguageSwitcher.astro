---
import { localeLabels, locales, type Locale } from '@/i18n/config';
import { pathForLocale } from '@/i18n/utils';

const { locale, path } = Astro.props as {
  locale: Locale;
  path: string;
};
---

<nav class="language-switcher" aria-label="Language">
  {locales.map((item) => (
    <a class:list={[{ active: item === locale }]} href={pathForLocale(item, path)}>
      {localeLabels[item]}
    </a>
  ))}
</nav>
