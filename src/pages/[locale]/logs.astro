---
import LogsPage from '@/components/pages/LogsPage.astro';
import { defaultLocale, isLocale, prefixedLocales } from '@/i18n/config';

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
const locale = isLocale(rawLocale) ? rawLocale : defaultLocale;
---

<LogsPage locale={locale} path="/logs" />
