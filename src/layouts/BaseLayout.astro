---
import SiteHeader from '@/components/SiteHeader.astro';
import { type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import '@/styles/global.css';

const { locale, title, description, path = '/' } = Astro.props as {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
};

const pageTitle = title ? `${title} · ${t(locale, 'siteTitle')}` : t(locale, 'siteTitle');
const pageDescription = description ?? t(locale, 'siteDescription');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader locale={locale} path={path} />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>{t(locale, 'footerNote')}</span>
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const storedTheme = window.localStorage.getItem('udon-tools-theme');

      if (storedTheme === 'dark') {
        root.dataset.theme = 'dark';
      }

      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';

          if (nextTheme === 'dark') {
            root.dataset.theme = 'dark';
            window.localStorage.setItem('udon-tools-theme', 'dark');
          } else {
            delete root.dataset.theme;
            window.localStorage.setItem('udon-tools-theme', 'light');
          }
        });
      });

      document.querySelectorAll<HTMLSelectElement>('[data-language-select]').forEach((select) => {
        select.addEventListener('change', () => {
          window.location.href = select.value;
        });
      });

      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker
          .register('/service-worker.js')
          .catch(() => {});
      }
    </script>
  </body>
</html>
