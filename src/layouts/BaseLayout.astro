---
import SiteHeader from '@/components/SiteHeader.astro';
import { type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';
import '@/styles/global.css';

const { locale, title, description, path = '/' } = Astro.props as {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
};

const pageTitle = title ? `${title} · ${t(locale, 'siteTitle')}` : t(locale, 'siteTitle');
const pageDescription = description ?? t(locale, 'siteDescription');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader locale={locale} path={path} />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>{t(locale, 'footerNote')}</span>
      </footer>
    </div>
  </body>
</html>
