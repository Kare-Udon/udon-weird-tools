{
  "name": "weird-tools-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A static-first, i18n-ready Astro + TypeScript + React starter for browser-only personal tools.",
  "scripts": {
    "dev": "NODE_ENV=development astro dev --force",
    "build": "npm run validate:tools && astro build && node scripts/generate-service-worker.mjs && npm run validate:offline",
    "preview": "astro preview",
    "typecheck": "astro check",
    "validate:offline": "node scripts/validate-offline.mjs",
    "validate:tools": "node scripts/validate-tools.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "astro": "^6.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
